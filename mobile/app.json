{
  "expo": {
    "name": "Ravyn",
    "slug": "ravyn-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ravyn",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
